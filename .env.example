# MariaDB
MARIADB_ROOT_PASSWORD=generate-password
MARIADB_USER=formr_user
MARIADB_PASSWORD=generate-password
# Keep 'formr' — it matches formr.org's sql/schema.sql, which MariaDB auto-loads
# on first DB init (setup.sh copies it into mysql/dbinitial/).
MARIADB_DATABASE=formr

# Domains for single-host local dev (use_study_subdomains is forced off)
MAIN_DOMAIN=localhost
FORMR_DOMAIN=localhost
OPENCPU_DOMAIN=localhost:8080

# First superadmin (created by build.sh). Use a real address if you want to test
# email verification locally. Must be syntactically valid with a dotted domain:
# PHP's FILTER_VALIDATE_EMAIL rejects e.g. admin@localhost, and the login form
# silently ignores such addresses.
FORMR_EMAIL=admin@example.com
FORMR_PASSWORD=generate-password

# formr.org branch or tag to clone. master = latest development.
FORMR_TAG=master

TIMEZONE=Europe/Berlin

# Optional: pull the prebuilt public dev images instead of building locally.
# FORMR_REGISTRY=ghcr.io/rubenarslan
# FORMR_DEV_TAG=latest
